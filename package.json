{
  "name": "your-little-music-library",
  "productName": "Your Little Music Library",
  "private": true,
  "version": "1.0.0",
  "description": "A music player for the music files on your computer, with master and per-song volume.",
  "author": "TheBigVoid",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "app": "npm run build && electron .",
    "app:dev": "node electron/dev.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "release:win": "npm run build && electron-builder --win --publish always"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.thebigvoid.yourlittlemusiclibrary",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/updater.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Your Little Music Library",
      "uninstallDisplayName": "Your Little Music Library",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Your-Little-Music-Library-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "artifactName": "Your-Little-Music-Library-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "artifactName": "Your-Little-Music-Library-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "TheBigVoid",
        "repo": "Your-Little-Music-Library",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
